# Используем легкий официальный образ Python 3.13
FROM python:3.13-slim

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем зависимости и устанавливаем их заранее (для кэширования слоев)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем все исходные файлы проекта в контейнер
COPY . .

# Открываем порт для приложения
EXPOSE 8000

# Запускаем FastAPI через Uvicorn
# Используем один воркер для экономии памяти и обеспечения скорости отклика
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]